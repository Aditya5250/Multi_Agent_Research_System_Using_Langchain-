# ==========================================
# Multi-Agent Research System Configuration
# ==========================================

# Google Gemini API Key (Required)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Web Search API Key (Required)
# Obtain from Tavily AI: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Gemini Model Selection
# Default: models/gemini-3.5-flash-lite
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash, models/gemini-3.5-flash-lite
GEMINI_MODEL=models/gemini-3.5-flash-lite
